{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow_answer.schema.json",
  "title": "Business-Flow Analysis Answer",
  "description": "The reasoning layer's answer to one business-flow analysis request (feature 015, contracts/business-flow-artifact.md §3). Assessments are closed; undetermined states MUST carry reasons.",
  "type": "object",
  "additionalProperties": false,
  "required": ["flow_id", "assessment"],
  "properties": {
    "flow_id": { "type": "string", "minLength": 1 },
    "assessment": { "enum": ["clean", "gap", "violation", "undetermined"] },
    "undetermined_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "severity_score", "confidence", "location"],
        "properties": {
          "cwe": { "type": "string" },
          "severity_score": { "type": "number", "minimum": 0, "maximum": 10 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "location": {
            "type": "object",
            "required": ["repo", "file"],
            "properties": {
              "repo": { "type": "string" },
              "file": { "type": "string", "minLength": 1 },
              "symbol": { "type": "string" },
              "line_start": { "type": "integer", "minimum": 1 },
              "line_end": { "type": "integer", "minimum": 1 }
            }
          },
          "description": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "reason"],
              "properties": {
                "repo": { "type": "string" },
                "file": { "type": "string", "minLength": 1 },
                "reason": { "type": "string", "minLength": 1 },
                "symbol": { "type": "string" }
              }
            }
          },
          "attack_scenario": { "type": "string" },
          "impact": { "type": "string" },
          "recommendation": { "type": "string" },
          "missing_check": { "type": "string" },
          "compromise": { "type": "string" },
          "regulatory_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["regime", "obligation"],
              "properties": {
                "regime": { "type": "string", "minLength": 1 },
                "obligation": { "type": "string", "minLength": 1 },
                "basis": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}

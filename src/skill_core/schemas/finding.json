{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Security Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "cwe",
    "severity_score",
    "severity_band",
    "confidence",
    "location",
    "description",
    "evidence",
    "attack_scenario",
    "impact",
    "recommendation",
    "source",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SEC-[0-9]{4,}$"
    },
    "cwe": {
      "type": "string",
      "pattern": "^CWE-[0-9]+$"
    },
    "owasp_top10": {
      "type": "string"
    },
    "severity_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10.0
    },
    "severity_band": {
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low",
        "None"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "file",
        "line_start",
        "line_end"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "tier": {
          "enum": [
            "symbol",
            "file"
          ],
          "description": "resolution tier (FR-003). 'symbol': the language is parsed and the line range is authoritative from the code model. 'file': the language is not parsed; the file and line bounds were verified. Both are positive results - an unresolvable location is rejected, never reported."
        },
        "symbol_confirmed": {
          "type": "boolean",
          "description": "false at file tier even when a symbol name was reported (FR-003a)"
        },
        "alternatives_existed": {
          "type": "boolean",
          "description": "the symbol name was ambiguous; see chosen_by (FR-004)"
        },
        "chosen_by": {
          "type": "string",
          "description": "the deterministic tie-break applied when alternatives existed (FR-004)"
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "file",
          "reason"
        ],
        "properties": {
          "repo": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "segment_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "attack_scenario": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "related_symbols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detection": {
      "enum": [
        "format",
        "heuristic"
      ],
      "description": "detection provenance (feature 003): format = known credential format; heuristic = statistical match. heuristic findings are never auto-verified (FR-008)"
    },
    "code_context": {
      "enum": [
        "production",
        "test"
      ],
      "description": "deterministic test-code classification of the finding location (FR-010)"
    },
    "mitigation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Spec 007: demonstrated vs undetermined control evidence for LLM/agent findings. 'undetermined' MUST carry a reason — an unknown may neither suppress nor inflate (constitution V).",
      "required": [
        "control",
        "state"
      ],
      "properties": {
        "control": {
          "enum": [
            "isolation-boundary",
            "validation",
            "human-approval"
          ]
        },
        "state": {
          "enum": [
            "demonstrated",
            "undetermined"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "required when state = 'undetermined'; states why the control could not be proven either way"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "undetermined"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    },
    "source": {
      "enum": [
        "analysis",
        "scanner-ingest",
        "dependency-audit",
        "external-tool"
      ]
    },
    "tool_ref": {
      "type": "string"
    },
    "compliance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "segment_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "local",
        "segment-confirmed",
        "correlated",
        "reported",
        "rejected"
      ]
    },
    "rejection_reason": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "plausible",
            "disproven"
          ]
        },
        "gap": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ordered source-to-sink node ids forming the traced path"
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "description": "FR-008-FR-011. 'trigger' and 'observed_behavior' were unconditionally required before feature 002; they are now conditional on 'mode' so a finding the pipeline did not verify cannot assert an observation. Blocks written before 002 carry no 'mode' and remain valid.",
      "required": [
        "preconditions",
        "expected_behavior"
      ],
      "properties": {
        "preconditions": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1
        },
        "observed_behavior": {
          "type": "string",
          "minLength": 1,
          "description": "permitted only when verification.status = 'verified' (FR-008)"
        },
        "mode": {
          "enum": [
            "observed",
            "hypothesis"
          ],
          "description": "'observed' only for a finding verified end to end; otherwise 'hypothesis' (FR-008)"
        },
        "outcome_to_check": {
          "type": "string",
          "minLength": 1,
          "description": "replaces observed_behavior when mode = 'hypothesis'"
        },
        "trigger_omitted_reason": {
          "type": "string",
          "minLength": 1,
          "description": "required when no probe with an achievable success criterion exists (FR-010)"
        },
        "traced_trail": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "traced-path nodes only, a subset of verification.path; omitted when no path was traced (FR-005)"
        },
        "evidence_trail": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "deprecated": true,
          "description": "DEPRECATED and no longer populated as of feature 002. It conflated the traced path with unrelated supporting evidence while being rendered with dataflow notation (FR-005/FR-006). Retained so pre-002 artifacts still validate; superseded by traced_trail. Removal is deferred to a release that bumps schema_version."
        },
        "target_scope": {
          "const": "local/test"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "observed"
              }
            }
          },
          "then": {
            "required": [
              "observed_behavior"
            ]
          }
        },
        {
          "if": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "hypothesis"
              }
            }
          },
          "then": {
            "required": [
              "outcome_to_check"
            ]
          }
        },
        {
          "if": {
            "required": [
              "mode"
            ],
            "not": {
              "required": [
                "trigger"
              ]
            }
          },
          "then": {
            "required": [
              "trigger_omitted_reason"
            ]
          }
        }
      ]
    },
    "reclassification": {
      "type": "object",
      "additionalProperties": false,
      "description": "FR-016/FR-017. Retained even when the resulting finding falls below the profile's reporting threshold, so the decision stays auditable.",
      "required": [
        "original_cwe",
        "new_cwe",
        "reason"
      ],
      "properties": {
        "original_cwe": {
          "type": "string",
          "pattern": "^CWE-[0-9]+$"
        },
        "new_cwe": {
          "type": "string",
          "pattern": "^CWE-[0-9]+$"
        },
        "original_severity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 10.0
        },
        "new_severity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 10.0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "operator_override": {
          "type": "boolean",
          "description": "set when an explicit profile request beat suppression (FR-019)"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "description": "FR-015a-FR-015c. Only applicable=false may trigger a remap; true and 'undetermined' both retain the finding as classified.",
      "required": [
        "applicable"
      ],
      "properties": {
        "applicable": {
          "enum": [
            true,
            false,
            "undetermined"
          ]
        },
        "reachable_shapes": {
          "type": "array",
          "items": {
            "enum": [
              "server-request-issuer",
              "browser-client",
              "cli",
              "library",
              "undetermined"
            ]
          }
        },
        "enabling_member": {
          "type": "string",
          "description": "the workspace member that makes the class applicable, when one does"
        },
        "reason": {
          "type": "string",
          "description": "required when applicable is false or 'undetermined'"
        }
      }
    },
    "framework_control": {
      "type": "object",
      "additionalProperties": false,
      "description": "FR-021-FR-022d. 'absent' is a determined state; 'unassessed' is not, and never inflates severity.",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "credited",
            "bypassed",
            "absent",
            "unassessed"
          ]
        },
        "control": {
          "type": "string"
        },
        "bypass_site": {
          "$ref": "#/properties/location"
        },
        "unassessed_reason": {
          "type": "string",
          "description": "required when state = 'unassessed': unrecognized framework, or an unparsed file on the traced path"
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "description": "FR-020. Why the published severity/confidence differ from what analysis proposed.",
      "properties": {
        "proposed_severity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 10.0
        },
        "proposed_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "caps_applied": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "reason"
            ],
            "properties": {
              "rule": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "description": "FR-030-FR-035. Present when source = 'dependency-audit'.",
      "required": [
        "package",
        "ecosystem",
        "exposure",
        "attribution"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "ecosystem": {
          "type": "string"
        },
        "affected_range": {
          "type": "string"
        },
        "fixed_version": {
          "type": "string"
        },
        "advisory_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exposure": {
          "enum": [
            "runtime",
            "development"
          ]
        },
        "affected_members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attribution": {
          "enum": [
            "per-member",
            "workspace-not-derivable"
          ]
        },
        "version_ambiguous": {
          "type": "boolean",
          "description": "a manifest exists with no lockfile, so the resolved version is ambiguous (FR-035)"
        },
        "audit_source": {
          "type": "string"
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "type"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^SEC-[0-9]{4,}$"
          },
          "type": {
            "enum": [
              "same",
              "related",
              "dependent",
              "duplicate",
              "independent"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^SEC-[0-9]{4,}$",
      "description": "set on duplicates: the finding that represents this group in the report"
    },
    "code_excerpt": {
      "type": "object",
      "additionalProperties": false,
      "description": "Feature 005. Redacted excerpt of the cited source, attached to every admitted finding. status='unavailable' carries a reason and no lines - an excerpt is never fabricated and never silently absent (FR-007-FR-010).",
      "required": [
        "repo",
        "file",
        "cited_start",
        "cited_end",
        "window_start",
        "window_end",
        "truncated",
        "status"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "cited_start": {
          "type": "integer",
          "minimum": 1
        },
        "cited_end": {
          "type": "integer",
          "minimum": 1
        },
        "window_start": {
          "type": "integer",
          "minimum": 1
        },
        "window_end": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "number",
              "text",
              "cited",
              "truncated"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string"
              },
              "cited": {
                "type": "boolean"
              },
              "truncated": {
                "type": "boolean"
              }
            }
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ok",
            "unavailable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "not": {
              "required": [
                "lines"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "required": [
              "lines"
            ]
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Feature 008 (FR-006): every contributor after external/native dedupe - provenance, additively present on merged findings."
    },
    "scanner": {
      "type": "string",
      "description": "Feature 008: registry id of the external tool that produced this finding."
    },
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Feature 013: record of an applied downgrade or user-declared resolution from the finding-triage round. Provenance of the applied verdict is auditable here; the finding's own evidence and grading remain visible.",
      "required": ["verdict", "rationale"],
      "properties": {
        "verdict": {
          "enum": ["confirmed", "downgraded", "refuted", "flagged"]
        },
        "rationale": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "file", "line_start", "line_end", "pattern"],
            "properties": {
              "repo": { "type": "string" },
              "file": { "type": "string" },
              "line_start": { "type": "integer", "minimum": 1 },
              "line_end": { "type": "integer", "minimum": 1 },
              "symbol": { "type": "string" },
              "pattern": { "type": "string" }
            }
          }
        },
        "previous_severity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 10.0
        },
        "previous_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "user_declaration": {
          "type": "object",
          "additionalProperties": false,
          "description": "set when a user-recorded declaration (not pipeline-derived evidence) produced this outcome",
          "required": ["answer", "resolution"],
          "properties": {
            "answer": { "type": "string" },
            "resolution": { "enum": ["downgrade", "refute"] }
          }
        }
      }
    },
    "awaiting_verification": {
      "type": "object",
      "additionalProperties": false,
      "description": "Feature 013: the finding was flagged by the triage round with a concrete open question. Grading is untouched; the flag is an addition, not a suppression.",
      "required": ["question", "provenance"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "settling_evidence_hint": { "type": "string" },
        "provenance": { "enum": ["triage", "user-declared"] }
      }
    },
    "triage_unresolved": {
      "type": "object",
      "additionalProperties": false,
      "description": "Feature 013: the triage round ran but did not adjudicate this finding (unanswered request or rejected verdict). Recorded, never silent.",
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}

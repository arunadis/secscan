{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "segment.schema.json",
  "title": "Segment",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "repos", "purpose", "files", "estimated_tokens"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "repos": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "purpose": { "type": "string" },
    "domains": {
      "type": "array",
      "items": { "type": "string" },
      "description": "vulnerability domains relevant to this segment (FR-011)"
    },
    "entrypoints": { "type": "array", "items": { "type": "string" } },
    "files": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "data_stores": { "type": "array", "items": { "type": "string" } },
    "estimated_tokens": { "type": "integer", "minimum": 0 },
    "subdivided_from": { "type": "string" },
    "integration_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "integration ids this segment participates in (cross-repo invalidation)"
    },
    "architecture": {
      "$ref": "architecture_profile.schema.json",
      "description": "present only when this segment's shape differs from its member's, which is how a hybrid repository is represented (FR-014)"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace.schema.json",
  "title": "Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "members", "integrations", "source"],
  "properties": {
    "id": { "type": "string" },
    "root": { "type": "string" },
    "source": { "enum": ["manifest", "auto-discovered"] },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_repo", "to_repo", "type", "declared", "confidence"],
        "properties": {
          "from_repo": { "type": "string" },
          "to_repo": { "type": "string" },
          "type": {
            "enum": ["sync-api", "async-messaging", "shared-datastore", "identity-propagation"]
          },
          "endpoints_or_channels": { "type": "array", "items": { "type": "string" } },
          "trust_boundary": { "type": "boolean" },
          "declared": { "type": "boolean" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        }
      }
    },
    "unavailable_members": {
      "type": "array",
      "items": { "type": "string" },
      "description": "manifest-declared repos that could not be read (coverage gap)"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usage.schema.json",
  "title": "Usage and Cost Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["total_input_tokens", "total_output_tokens", "by_stage", "invocations"],
  "properties": {
    "total_input_tokens": { "type": "integer", "minimum": 0 },
    "total_output_tokens": { "type": "integer", "minimum": 0 },
    "invocations": { "type": "integer", "minimum": 0 },
    "by_stage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["input_tokens", "output_tokens", "invocations"],
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "invocations": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "by_model_tier": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["input_tokens", "output_tokens", "invocations"],
        "properties": {
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "invocations": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "by_escalation_level": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "batch_share": {
      "type": "object",
      "properties": {
        "batch_invocations": { "type": "integer", "minimum": 0 },
        "interactive_invocations": { "type": "integer", "minimum": 0 },
        "fallbacks": { "type": "integer", "minimum": 0 }
      }
    },
    "fallback_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "baseline_comparison": {
      "type": "object",
      "description": "SC-004: savings vs maximal-context baseline",
      "properties": {
        "maximal_context_tokens": { "type": "integer", "minimum": 0 },
        "actual_tokens": { "type": "integer", "minimum": 0 },
        "savings_factor": { "type": "number", "minimum": 0 }
      }
    }
  }
}
